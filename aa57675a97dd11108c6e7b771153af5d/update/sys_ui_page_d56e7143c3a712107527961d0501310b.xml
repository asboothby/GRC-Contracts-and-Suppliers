<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_ui_page">
    <sys_ui_page action="INSERT_OR_UPDATE">
        <category>general</category>
        <client_script><![CDATA[function invokePromptCallBack(type) {
	var gdw = GlideDialogWindow.get();
	if (type == 'ok') {
alert('Acknowledgement Recorded')
	}
	else
	{
	alert('Acknowledgement Cancelled');
	}
			gdw.destroy();
		return false;	
}]]></client_script>
        <description/>
        <direct>false</direct>
        <endpoint>x_631631_grc_contr_AutoCtrls.do</endpoint>
        <html><![CDATA[<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">

<g:ui_form>

<g:evaluate var="jvar_entity_id" expression="RP.getWindowProperties().parent" />

<g:evaluate var="jvar_auto_ctrls" jelly="true" object="true">
var ctrlArray = [];
var auto_ctrls = new GlideRecord('sn_compliance_control');
auto_ctrls.addQuery('profile', jelly.jvar_entity_id);
auto_ctrls.addEncodedQuery('attestationISEMPTY^statusINcompliant,non_compliant,not_applicable');
auto_ctrls.query();
while (auto_ctrls.next()) {
	ctrlArray.push({control: auto_ctrls.getValue('name').toString(), status: auto_ctrls.getDisplayValue('status').toString()});
	gs.info(ctrlArray.toString());
}

ctrlArray;
</g:evaluate>
<p></p>
<p>System Answered Controls</p>
<p>Controls Set Based on Trigger Question responses</p>
<table width="90%" border="1">
<tr><th>Control</th><th>Status</th></tr>
</table>
<p></p><p></p>
Controls set by Automation / Monitoring
<p></p>
<table width="90%" border="1">
<tr><th>Control</th><th>Status</th></tr>
<j:forEach var="jvar_ctrl" items="${jvar_auto_ctrls}">
<tr><td>${jvar_ctrl.control}</td><td>${jvar_ctrl.status}</td></tr>
</j:forEach>
</table>
<g:dialog_button_ok
				ok_text="${gs.getMessage('Acknowledge')}"
				ok="invokePromptCallBack('ok');"
				ok_type="button" />
</g:ui_form>
</j:jelly>
]]></html>
